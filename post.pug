doctype html
head
  meta(charset='UTF-8')
  meta(name='viewport' content='width=device-width, initial-scale=1.0')
  title Snap Dragon - Post
  link(rel='stylesheet' href='css/style.css')
  script(src='js/data.js' defer='')
  script(src='js/main.js' defer='')
  script(src='js/post.js' defer='')
header.site-header
  .container
    h1 Snap Dragon
    p.tagline
      | A safe space where you can express your mental health struggles, share experiences and find comfort in knowing you are not alone.
nav.site-nav
  .container.nav-container
    ul.nav-links.left-nav
      li
        a(href='index.html') Home
      li
        a(href='createpost.html') Create Post
    ul#navAuth.nav-links.right-nav
main.container
  article#fullPost.card.single-post
  section.card.comments-section
    h2 Comments
    #commentsContainer
  section.card
    h2 Leave a Supportive Comment
    form#commentForm(novalidate='')
      .form-group
        label(for='commentUsername') Username
        input#commentUsername(type='text' placeholder='ex. user1234')
        small#commentUsernameError.error
      .form-group
        label(for='commentText') Comment
        textarea#commentText(rows='6')
        small#commentTextError.error
      button(type='submit') Post Comment
      p#commentSuccess.success.hidden Your comment was added.
footer.site-footer
  .container
    p &copy; 2026 Snap Dragon.

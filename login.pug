doctype html
head
  meta(charset='UTF-8')
  meta(name='viewport' content='width=device-width, initial-scale=1.0')
  title Snap Dragon - Login
  link(rel='stylesheet' href='css/style.css')
  script(src='js/data.js' defer='')
  script(src='js/main.js' defer='')
  script(src='js/auth.js' defer='')
header.site-header
  .container
    h1 Snap Dragon
    p.tagline
      | A safe space where you can express your mental health struggles, share experiences and find comfort in knowing you are not alone.
nav.site-nav
  .container.nav-container
    ul.nav-links.left-nav
      li
        a(href='index.html') Home
      li
        a(href='createpost.html') Create Post
    ul#navAuth.nav-links.right-nav
main.container
  section.card.form-card
    h2 Login
    form#loginForm(novalidate='')
      .form-group
        label(for='loginEmail') Email
        input#loginEmail(type='text' placeholder='Enter your email')
        small#loginEmailError.error
      .form-group
        label(for='loginPassword') Password
        input#loginPassword(type='password' placeholder='Enter your password')
        small#loginPasswordError.error
      button(type='submit') Login
      p#loginGlobalError.error
    p.form-note
      | Do not have an account yet? 
      a(href='register.html') Register here
      | .
footer.site-footer
  .container
    p &copy; 2026 Snap Dragon.
